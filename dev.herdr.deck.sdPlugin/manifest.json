{
  "Name": "Herd Deck",
  "Version": "0.1.0.0",
  "Author": "Mark Imbriaco",
  "Actions": [
    {
      "Name": "Agent Slot",
      "UUID": "dev.herdr.deck.agent-slot",
      "Icon": "imgs/actions/agent/icon",
